#include <SPI.h>
#include <RF24.h>

RF24 radio(4, 5);

const byte address[6] = "DRONE";

struct DataPacket {
  int throttle;
  int yaw;
  int pitch;
  int roll;
  bool arm;
};

DataPacket data;

void setup() {
  Serial.begin(115200);

  radio.begin();
  radio.openReadingPipe(0, address);
  radio.setPALevel(RF24_PA_LOW);
  radio.startListening();
}

void loop() {
  if (radio.available()) {
    radio.read(&data, sizeof(data));

    Serial.print("T:");
    Serial.print(data.throttle);
    Serial.print(" Y:");
    Serial.print(data.yaw);
    Serial.print(" P:");
    Serial.print(data.pitch);
    Serial.print(" R:");
    Serial.print(data.roll);
    Serial.print(" ARM:");
    Serial.println(data.arm);
  }
}
